# Keep LF everywhere: golden snapshots, USFM fixtures and embedded data are compared or
# parsed byte for byte, and Windows checkouts would otherwise turn them into CRLF.
* text=auto eol=lf
*.ttf binary
*.obr binary
# Dictionary indexes address byte offsets in their legacy-encoded data files.
crates/formats/tests/fixtures/study/*.dat binary
crates/formats/tests/fixtures/study/*.idx binary
crates/formats/tests/fixtures/study/*.zdt binary
crates/formats/tests/fixtures/study/*.zdx binary
# SWORD test module data files are compared by their reader, byte for byte.
crates/formats/tests/assets/sword/modules/** binary
# Update now (#276) verifies a detached minisign signature, byte for byte.
crates/engine/tests/update-signing/** binary
