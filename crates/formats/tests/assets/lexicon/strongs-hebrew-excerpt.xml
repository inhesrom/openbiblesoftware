    <div type="glossary">
      <div type="entry" n="1">
        <w gloss="4a" lemma="אָב" morph="n-m" POS="awb" xlit="ʼâb" ID="H1" xml:lang="heb">אב</w>
        <foreign xml:lang="grc">
          <w gloss="G:1118" />
          <w gloss="G:2730" />
          <w gloss="G:3390" />
          <w gloss="G:3507" />
          <w gloss="G:3509" />
          <w gloss="G:3962" />
          <w gloss="G:3965" />
          <w gloss="G:3966" />
          <w gloss="G:3967" />
          <w gloss="G:3971" />
        </foreign>
        <list>
          <item>(omitted from this fixture)</item>
        </list>
        <note type="exegesis">a primitive word;</note>
        <note type="explanation"><hi>father</hi>, in a literal and immediate, or figurative and remote application</note>
        <note type="translation">chief, (fore-) father(-less), [idiom] patrimony, principal. Compare names in 'Abi-'.</note>
      </div>
      <div type="entry" n="2">
        <w gloss="2553" lemma="אַב" morph="n-m" POS="ab" xlit="ʼab" ID="H2" xml:lang="arc">אב</w>
        <foreign xml:lang="grc">
          <w gloss="G:5" />
          <w gloss="G:912" />
        </foreign>
        <list>
          <item>(omitted from this fixture)</item>
        </list>
        <note type="exegesis">(Aramaic) corresponding to <w lemma="אָב" POS="awb" src="1" xlit="ʼâb"/></note>
        <note type="explanation">{<hi>father</hi>}</note>
        <note type="translation">father.</note>
      </div>
      <div type="entry" n="1254">
        <w gloss="278" lemma="בָּרָא" morph="v" POS="baw-raw'" xlit="bârâʼ" ID="H1254" xml:lang="heb">ברא</w>
        <foreign xml:lang="grc">
