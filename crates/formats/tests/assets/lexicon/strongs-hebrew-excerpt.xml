        <note type="exegesis">from <w lemma="חָנַן" POS="khaw-nan'" src="2603" xlit="chânan"/>;</note>
        <note type="explanation"><hi>graciousness</hi>, i.e. <hi>subjective</hi> (kindness, favor) or <hi>objective</hi> (beauty)</note>
        <note type="translation">favour, grace(-ious), pleasant, precious, (well-) favoured.</note>
      </div>
