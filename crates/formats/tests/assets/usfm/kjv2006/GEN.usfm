\id GEN Genesis
\h Genesis
\toc1 The First Book of Moses, called Genesis
\toc2 Genesis
\toc3 Gen
\mt1 The First Book of Moses, called Genesis
\c 1
\p
\v 1 In the \w beginning|strong="H7225"\w* \w God|strong="H0430"\w* \w created|strong="H1254"\w* the \w heaven|strong="H8064"\w* \w and|strong="H0853"\w* the \w earth|strong="H0776"\w*.
\v 2 And the \w earth|strong="H0776"\w* \w was|strong="H1961"\w* without \w form|strong="H8414"\w*, and \w void|strong="H0922"\w*; and \w darkness|strong="H2822"\w* \add was\add* upon the \w face|strong="H6440"\w* of the \w deep|strong="H8415"\w*. And the \w Spirit|strong="H7307"\w* of \w God|strong="H0430"\w* \w moved|strong="H7363"\w* \w upon|strong="H5921"\w* the \w face|strong="H6440"\w* of the \w waters|strong="H4325"\w*.
\p
\v 3 And \w God|strong="H0430"\w* \w said|strong="H0559"\w*, Let there \w be|strong="H1961"\w* \w light|strong="H0216"\w*: and there was \w light|strong="H0216"\w*.
\v 4 And \w God|strong="H0430"\w* \w saw|strong="H7200"\w* the \w light|strong="H0216"\w*, \w that|strong="H3588"\w* \add it was\add* \w good|strong="H2896"\w*: and \w God|strong="H0430"\w* \w divided|strong="H0914"\w* the \w light|strong="H0216"\w* \w from|strong="H0996"\w* the \w darkness|strong="H2822"\w*.\f + \fr 1.4 \ft the light from…: Heb. between the light and between the darkness\f*
\v 5 And \w God|strong="H0430"\w* \w called|strong="H7121"\w* the \w light|strong="H0216"\w* \w Day|strong="H3117"\w*, and the \w darkness|strong="H2822"\w* he \w called|strong="H7121"\w* \w Night|strong="H3915"\w*. And the \w evening|strong="H6153"\w* and the \w morning|strong="H1242"\w* were the \w first|strong="H0259"\w* \w day|strong="H3117"\w*.\f + \fr 1.5 \ft And the evening…: Heb. And the evening was, and the morning was etc.\f*
\c 2
\p
\v 4 ¶ \w These|strong="H0428"\w* \add are\add* the \w generations|strong="H8435"\w* of the \w heavens|strong="H8064"\w* and of the \w earth|strong="H0776"\w* when they were \w created|strong="H1254"\w*, in the \w day|strong="H3117"\w* that the \nd \+w LORD|strong="H3068"\+w*\nd* \w God|strong="H0430"\w* \w made|strong="H6213"\w* the \w earth|strong="H0776"\w* and the \w heavens|strong="H8064"\w*,
