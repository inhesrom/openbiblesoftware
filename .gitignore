/target
/.pi/
/dist/

# Copyrighted modules for local testing only (NASB95 etc.).
# See docs/dev/local-copyrighted-modules.md. Never commit these or their
# converted .obr / Search index output.
/local-modules/

# The Mobile app's Bundled set, copied from dist/starter/ by `cargo xtask ios bundled-set`.
/apps/ios/Bundled/

# The iOS app's build artefacts (docs/dev/ios-project.md): `xcodegen generate` writes the
# project from apps/ios/project.yml; `cargo xtask ios build` writes the XCFramework and the
# generated Swift into the local package.
/apps/ios/*.xcodeproj
# XcodeGen writes the app's Info.plist from project.yml's `info` (S26).
/apps/ios/OpenBible/Info.plist
/apps/ios/Packages/OpenBibleCore/ObsFFI.xcframework/
/apps/ios/Packages/OpenBibleCore/Sources/Generated/
/apps/ios/Packages/OpenBibleCore/.build/
/apps/ios/Packages/OpenBibleCore/.swiftpm/
